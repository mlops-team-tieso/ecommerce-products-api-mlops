{
	"info": {
		"name": "Products Service API",
		"description": "Product catalog microservice - CRUD operations, search with filters, stock control",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "product_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/",
					"host": ["{{base_url}}"],
					"path": [""]
				}
			}
		},
		{
			"name": "Get All Products",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/products",
					"host": ["{{base_url}}"],
					"path": ["products"]
				}
			}
		},
		{
			"name": "Get Products - Filter by Category",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/products?category=electronics",
					"host": ["{{base_url}}"],
					"path": ["products"],
					"query": [
						{"key": "category", "value": "electronics"}
					]
				}
			}
		},
		{
			"name": "Get Products - Filter by Price Range",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/products?min_price=10&max_price=50",
					"host": ["{{base_url}}"],
					"path": ["products"],
					"query": [
						{"key": "min_price", "value": "10"},
						{"key": "max_price", "value": "50"}
					]
				}
			}
		},
		{
			"name": "Get Products - Filter by Availability",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/products?available=true",
					"host": ["{{base_url}}"],
					"path": ["products"],
					"query": [
						{"key": "available", "value": "true"}
					]
				}
			}
		},
		{
			"name": "Get Products - Combined Filters",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/products?category=electronics&min_price=10&max_price=100&available=true",
					"host": ["{{base_url}}"],
					"path": ["products"],
					"query": [
						{"key": "category", "value": "electronics"},
						{"key": "min_price", "value": "10"},
						{"key": "max_price", "value": "100"},
						{"key": "available", "value": "true"}
					]
				}
			}
		},
		{
			"name": "Get Product by ID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/products/{{product_id}}",
					"host": ["{{base_url}}"],
					"path": ["products", "{{product_id}}"]
				}
			}
		},
		{
			"name": "Create Product",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.collectionVariables.set('product_id', jsonData.id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Wireless Mouse\",\n    \"description\": \"Ergonomic wireless mouse with USB receiver\",\n    \"category\": \"electronics\",\n    \"price\": 34.99,\n    \"stock\": 100,\n    \"image_url\": \"\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/products",
					"host": ["{{base_url}}"],
					"path": ["products"]
				}
			}
		},
		{
			"name": "Update Product",
			"request": {
				"method": "PUT",
				"header": [
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Wireless Mouse Pro\",\n    \"price\": 44.99\n}"
				},
				"url": {
					"raw": "{{base_url}}/products/{{product_id}}",
					"host": ["{{base_url}}"],
					"path": ["products", "{{product_id}}"]
				}
			}
		},
		{
			"name": "Update Stock",
			"request": {
				"method": "PUT",
				"header": [
					{"key": "Content-Type", "value": "application/json"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"stock\": 75\n}"
				},
				"url": {
					"raw": "{{base_url}}/products/{{product_id}}/stock",
					"host": ["{{base_url}}"],
					"path": ["products", "{{product_id}}", "stock"]
				}
			}
		}
	]
}
